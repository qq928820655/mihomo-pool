# 复制为 .env 后按需修改
MPOOL_PORT=8006
MPOOL_TOKEN=changeme
MPOOL_CONTROLLER=127.0.0.1:9090
# 逐节点端口池起点与数量（17901..17900+MAX）
MPOOL_LISTEN_BASE=17901
MPOOL_LISTEN_MAX=32
# 三个 Hub 出口端口：固定 / 轮换 / 粘性分配（改后重启服务生效）
MPOOL_HUB_PORTS=7890,7891,7892
# 本地节点端口（HTTP/SOCKS 代理 与 vmess 入站）
MPOOL_LOCAL_PORT=7893
MPOOL_LOCAL_VLESS_PORT=17990
MPOOL_CFWS_PORT=8443
